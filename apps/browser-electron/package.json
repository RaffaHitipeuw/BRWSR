{
  "name": "eduos-browser",
  "version": "0.1.0",
  "description": "EduOS Browser - Native WebView Browser",
  "author": "EduOS Team",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:react": "vite",
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "preview": "vite preview",
    "electron": "electron .",
    "start": "electron .",
    "dist": "npm run build:prod && electron-builder --win --dir",
    "dist:all": "npm run build:prod && electron-builder --win",
    "analyze": "vite build --mode analyze"
  },
  "build": {
    "appId": "id.eduos.browser",
    "productName": "EduOS Browser",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*"
    ],
    "asar": false,
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "forceCodeSigning": false
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.4",
    "terser": "^5.49.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.0"
  },
  "overrides": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "use-sync-external-store": "^1.2.2"
  }
}
