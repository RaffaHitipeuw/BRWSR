{
  "$schema": "https://schema.tauri.app/config/2/capabilities",
  "identifier": "browser-capability",
  "description": "Capability for the EduOS Browser",
  "windows": ["main", "native-overlay"],
  "webviews": ["browser", "native-overlay"],
  "remote": {
    "urls": ["http://localhost:5173", "https://*"]
  },
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-is-maximized",
    "core:window:allow-unmaximize",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:webview:default",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-webview-close",
    "shell:allow-open",
    "log:default",
    "core:default",
    "allow-handle-cbt-signal",
    "allow-navigate-browser",
    "allow-get-cbt-state",
    "allow-get-network-state",
    "allow-get-network-isolation-state",
    "allow-show-native-overlay",
    "allow-hide-native-overlay",
    "allow-is-native-overlay-visible",
    "allow-minimize-window",
    "allow-toggle-maximize",
    "allow-close-window",
    "allow-raise-browser-zorder",
    "allow-reload-browser",
    "allow-back-browser",
    "allow-forward-browser",
    "allow-get-webview-url",
    "allow-inject-url-tracker",
    "allow-get-webview-state",
    "allow-webview-url-update",
    "allow-emit-history-navigate",
    "allow-create-tab"
  ]
}
